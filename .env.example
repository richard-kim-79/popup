# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 토스페이먼츠
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...
TOSS_WEBHOOK_SECRET=your_webhook_secret

# 카카오톡 공유
NEXT_PUBLIC_KAKAO_JS_KEY=your_kakao_js_key

# Resend (이메일 전송)
RESEND_API_KEY=re_placeholder

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
EDIT_TOKEN_SECRET=change_this_to_a_random_32_char_string_minimum

# 앱인토스 (Apps in Toss) 개발자 콘솔
# https://developers-apps-in-toss.toss.im 에서 발급
AIT_API_KEY=TODO

# 토스 자동결제(빌링) — 별도 MID. 정기결제 권한이 활성화된 키여야 함.
NEXT_PUBLIC_TOSS_BILLING_CLIENT_KEY=test_ck_...
TOSS_BILLING_SECRET_KEY=test_sk_...
